FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src
WORKDIR /app
COPY requirements-nebius-dashboard.txt ./
RUN pip install --no-cache-dir -r requirements-nebius-dashboard.txt && pip check
COPY src/nebius_common.py src/nebius_dashboard_api.py ./src/
RUN python -m compileall -q src
CMD ["sh", "-c", "exec python -m uvicorn nebius_dashboard_api:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
